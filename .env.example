# Environment Variables for Kotaemon with Azure OpenAI
# ⚠️ IMPORTANT: Replace all placeholder values with your actual credentials

# Azure OpenAI Configuration
# Get these from your Azure OpenAI service in Azure Portal
AZURE_OPENAI_ENDPOINT=<YOUR_AZURE_OPENAI_ENDPOINT>
AZURE_OPENAI_API_KEY=<YOUR_AZURE_OPENAI_API_KEY>
OPENAI_API_VERSION=<YOUR_OPENAI_API_VERSION>

# Model Deployments
# Replace with your actual deployment names in Azure OpenAI
AZURE_OPENAI_CHAT_DEPLOYMENT=<YOUR_CHAT_DEPLOYMENT>
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=<YOUR_EMBEDDINGS_DEPLOYMENT>

# Vision Language Model (VLM) for image captioning
# Used for processing images in documents
VLM_DEPLOYMENT=<YOUR_VLM_DEPLOYMENT>

# Gradio Server Configuration
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# LLM Parameters
TEMPERATURE=1.0

# SSL/TLS Configuration
NODE_TLS_REJECT_UNAUTHORIZED=0

# Optional: GraphRAG Configuration
# Uncomment if using GraphRAG (requires separate OpenAI API key)
# GRAPHRAG_API_KEY=<YOUR_OPENAI_API_KEY>
# GRAPHRAG_LLM_MODEL=gpt-4o-mini
# GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small
# USE_MS_GRAPHRAG=true
# USE_NANO_GRAPHRAG=false

# Optional: Reranking Configuration
# Uncomment if using Cohere reranking
# COHERE_API_KEY=<YOUR_COHERE_API_KEY>

# Optional: VoyageAI Reranking
# VOYAGEAI_API_KEY=<YOUR_VOYAGEAI_API_KEY>
